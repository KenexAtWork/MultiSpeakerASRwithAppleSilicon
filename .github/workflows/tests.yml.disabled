# GitHub Actions 暫時禁用
# 原因：MLX 需要 Apple Silicon，GitHub 的 macOS runner 是 Intel 架構
# 請使用本地測試腳本：./run_tests.sh 或 ./ci_test.sh

# name: ASR Tests
# 
# on:
#   push:
#     branches: [ main, develop ]
#   pull_request:
#     branches: [ main, develop ]

jobs:
  test:
    runs-on: macos-latest  # 需要 macOS 因為使用 MLX (Apple Silicon)
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'
    
    - name: Install system dependencies
      run: |
        brew install ffmpeg
    
    - name: Cache Python dependencies
      uses: actions/cache@v4
      with:
        path: ~/.cache/pip
        key: ${{ runner.os }}-pip-${{ hashFiles('**/pyproject.toml', '**/requirements.txt') }}
        restore-keys: |
          ${{ runner.os }}-pip-
    
    - name: Install Python dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -e .
        pip install -r gui/requirements.txt
    
    - name: Run tests (fast mode)
      env:
        HF_TOKEN: ${{ secrets.HF_TOKEN }}
      run: |
        cd asr
        python tests/test_merge_srt.py
        python tests/test_srt_parser.py
        python tests/test_error_handling.py
        python tests/test_pipeline_e2e.py --fast
        python tests/test_gui_media_url.py
    
    - name: Upload test results
      if: failure()  # 只在失敗時上傳
      uses: actions/upload-artifact@v4
      with:
        name: test-results
        path: |
          asr/tests/visual/screenshots/
        if-no-files-found: ignore  # 如果沒有檔案就忽略
